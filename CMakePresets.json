{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-base", "hidden": true, "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe", "CMAKE_CXX_COMPILER": "cl.exe",
        "CMAKE_PREFIX_PATH": "${sourceDir}/.runtime/Qt/5.15.2/msvc2019_64",
        "Qt5_DIR": "${sourceDir}/.runtime/Qt/5.15.2/msvc2019_64/lib/cmake/Qt5",
        "VCPKG_APPLOCAL_DEPS": "OFF"
      },
      "architecture": {"value":"x64","strategy":"external"},
      "condition": {"type":"equals","lhs":"${hostSystemName}","rhs":"Windows"}
    },
    {"name":"x64-release","inherits":"windows-base","displayName":"EduCode / Qt 5 / Release","binaryDir":"${sourceDir}/out/build/educode-qt5-release","cacheVariables":{"CMAKE_BUILD_TYPE":"Release"}},
    {"name":"x64-debug","inherits":"windows-base","displayName":"EduCode / Qt 5 / Debug","binaryDir":"${sourceDir}/out/build/educode-qt5-debug","cacheVariables":{"CMAKE_BUILD_TYPE":"Debug"}}
  ],
  "buildPresets": [
    {"name":"x64-release","configurePreset":"x64-release"},
    {"name":"x64-debug","configurePreset":"x64-debug"}
  ]
}
